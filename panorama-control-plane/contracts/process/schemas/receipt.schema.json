{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:panorama:process:schema:receipt:1",
  "title": "panorama.process-receipt.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "formatVersion": {
      "const": "panorama.process-receipt.v1"
    },
    "purpose": {
      "$ref": "urn:panorama:process:schema:common:1#/$defs/purpose"
    },
    "receiptId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "receiptHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "executionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "binding": {
      "$ref": "urn:panorama:process:schema:common:1#/$defs/binding"
    },
    "workItemRef": {
      "$ref": "urn:panorama:process:schema:common:1#/$defs/workRef"
    },
    "contextSnapshot": {
      "$ref": "urn:panorama:process:schema:common:1#/$defs/context"
    },
    "candidateBinding": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "candidateId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "candidateVersion": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "baselineSnapshotId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            }
          },
          "required": [
            "candidateId",
            "candidateVersion",
            "baselineSnapshotId"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "rulePacks": {
      "type": "array",
      "items": {
        "$ref": "urn:panorama:process:schema:common:1#/$defs/packRef"
      },
      "minItems": 1,
      "maxItems": 20
    },
    "sourceSnapshotId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "pattern": "\\S"
        },
        "kind": {
          "enum": [
            "local_capture",
            "external_import",
            "legacy_import",
            "contract_fixture"
          ]
        },
        "authority": {
          "enum": [
            "observed",
            "declared"
          ]
        }
      },
      "required": [
        "id",
        "version",
        "kind",
        "authority"
      ]
    },
    "inputSets": {
      "type": "array",
      "items": {
        "$ref": "urn:panorama:process:schema:common:1#/$defs/inputSet"
      },
      "minItems": 1,
      "maxItems": 100
    },
    "subjects": {
      "type": "array",
      "items": {
        "$ref": "urn:panorama:process:schema:common:1#/$defs/subject"
      },
      "minItems": 1,
      "maxItems": 1000
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "urn:panorama:process:schema:common:1#/$defs/check"
      },
      "minItems": 1,
      "maxItems": 1000
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "urn:panorama:process:schema:common:1#/$defs/evidence"
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "identityDigest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "coverage": {
          "const": "declared_subset"
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000,
                "pattern": "\\S"
              },
              "binaryDigest": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "id",
              "version",
              "binaryDigest"
            ]
          },
          "minItems": 0,
          "maxItems": 1000
        },
        "dependencyDigests": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              },
              "digest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "id",
              "digest"
            ]
          },
          "minItems": 0,
          "maxItems": 1000
        },
        "unknowns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "pattern": "\\S"
          },
          "minItems": 0,
          "maxItems": 1000
        }
      },
      "required": [
        "identityDigest",
        "coverage",
        "tools",
        "dependencyDigests",
        "unknowns"
      ]
    },
    "enforcement": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "mechanism": {
            "enum": [
              "guidance",
              "interface_rejection",
              "post_write_scan",
              "host_interception"
            ]
          },
          "status": {
            "enum": [
              "observed",
              "declared",
              "unknown"
            ]
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "minItems": 0,
            "maxItems": 1000,
            "uniqueItems": true
          }
        },
        "required": [
          "mechanism",
          "status",
          "evidenceIds"
        ]
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "upstreamCompletionClaim": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source": {
              "enum": [
                "structure-core",
                "pi-development-harness",
                "coding_agent"
              ]
            },
            "status": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000,
              "pattern": "\\S"
            },
            "summary": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000,
              "pattern": "\\S"
            }
          },
          "required": [
            "source",
            "status",
            "summary"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000,
        "pattern": "\\S"
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "content": {
          "const": "summary_and_hash_references_only"
        },
        "producerDeclared": {
          "const": true
        },
        "omittedCategories": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "pattern": "\\S"
          },
          "minItems": 0,
          "maxItems": 1000,
          "uniqueItems": true
        }
      },
      "required": [
        "content",
        "producerDeclared",
        "omittedCategories"
      ]
    },
    "extensions": {
      "type": "object",
      "maxProperties": 40,
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
      },
      "additionalProperties": true
    }
  },
  "required": [
    "formatVersion",
    "purpose",
    "receiptId",
    "receiptHash",
    "executionId",
    "binding",
    "workItemRef",
    "contextSnapshot",
    "candidateBinding",
    "rulePacks",
    "sourceSnapshotId",
    "producer",
    "inputSets",
    "subjects",
    "checks",
    "evidence",
    "environment",
    "enforcement",
    "upstreamCompletionClaim",
    "generatedAt",
    "limitations",
    "redaction",
    "extensions"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "purpose": {
            "const": "contract_example"
          }
        },
        "required": [
          "purpose"
        ]
      },
      "then": {
        "properties": {
          "producer": {
            "properties": {
              "kind": {
                "const": "contract_fixture"
              },
              "authority": {
                "const": "declared"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "producer": {
            "properties": {
              "kind": {
                "not": {
                  "const": "contract_fixture"
                }
              }
            }
          }
        }
      }
    }
  ]
}
