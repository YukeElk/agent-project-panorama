{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/panorama/event-retention-policy.schema.v0.1.json",
  "title": "Panorama Event Retention Policy v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "policyId",
    "projectId",
    "effectiveAt",
    "retentionDays",
    "maxEventBytes",
    "maxEvents",
    "allowedAccessClasses",
    "containsProjectContentAllowed",
    "containsSecretAllowed",
    "containsSensitivePersonalDataAllowed",
    "deletionMode",
    "extensions"
  ],
  "properties": {
    "formatVersion": {"const": "panorama-event-retention-policy.v0.1"},
    "policyId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "projectId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "effectiveAt": {"type": "string", "format": "date-time"},
    "retentionDays": {"type": ["integer", "null"], "minimum": 1},
    "maxEventBytes": {"type": "integer", "minimum": 1024, "maximum": 1048576},
    "maxEvents": {"type": ["integer", "null"], "minimum": 1},
    "allowedAccessClasses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["PUBLIC_PROJECT_EVIDENCE", "PROJECT_OPERATIONAL_METADATA", "EXTERNAL_PRIVATE_DATA"]
      }
    },
    "containsProjectContentAllowed": {"const": false},
    "containsSecretAllowed": {"const": false},
    "containsSensitivePersonalDataAllowed": {"const": false},
    "deletionMode": {"const": "redaction_manifest_then_new_epoch"},
    "extensions": {"type": "object"}
  }
}
