{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-project-panorama.local/schema/panorama-explain-pack.schema.v0.1.json",
  "title": "Panorama Explain Pack v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion", "explainPackId", "generatedAt", "compiler",
    "projectBinding", "modelBinding", "viewSetBinding", "stories",
    "coreReferences", "informationGaps", "limitations", "integrity", "extensions"
  ],
  "properties": {
    "formatVersion": {"const": "panorama-explain-pack.v0.1"},
    "explainPackId": {"type": "string", "pattern": "^PEP-[A-F0-9]{24}$"},
    "generatedAt": {"type": "string", "format": "date-time"},
    "compiler": {"$ref": "#/$defs/compiler"},
    "projectBinding": {"$ref": "#/$defs/projectBinding"},
    "modelBinding": {"$ref": "#/$defs/modelBinding"},
    "viewSetBinding": {"$ref": "#/$defs/viewSetBinding"},
    "stories": {
      "type": "array", "minItems": 1, "maxItems": 88,
      "items": {"$ref": "#/$defs/story"}
    },
    "playbackScenarios": {
      "type": "array", "maxItems": 32,
      "items": {"$ref": "#/$defs/playbackScenario"}
    },
    "coreReferences": {
      "type": "array", "maxItems": 10000,
      "items": {"$ref": "#/$defs/coreReference"}
    },
    "informationGaps": {
      "type": "array", "maxItems": 1000, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 1024}
    },
    "limitations": {
      "type": "array", "maxItems": 100, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 1024}
    },
    "integrity": {"$ref": "#/$defs/integrity"},
    "extensions": {"type": "object"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "stableId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "compiler": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"const": "panorama-explain-pack-compiler"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
      }
    },
    "projectBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["projectId", "panoramaSchemaVersion", "revision", "dataHash"],
      "properties": {
        "projectId": {"$ref": "#/$defs/stableId"},
        "panoramaSchemaVersion": {"enum": ["0.1", "0.2"]},
        "revision": {"type": "integer", "minimum": 0},
        "dataHash": {"$ref": "#/$defs/sha256"}
      }
    },
    "modelBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["modelId", "semanticHash", "asOf"],
      "properties": {
        "modelId": {"type": "string", "pattern": "^MODEL-[A-F0-9]{24}$"},
        "semanticHash": {"$ref": "#/$defs/sha256"},
        "asOf": {"type": "string", "format": "date-time"}
      }
    },
    "viewSetBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["viewSetId", "semanticHash", "defaultChapterId", "chapterCount"],
      "properties": {
        "viewSetId": {"type": "string", "pattern": "^PVS-[A-F0-9]{24}$"},
        "semanticHash": {"$ref": "#/$defs/sha256"},
        "defaultChapterId": {"type": "string", "pattern": "^CHAPTER-[A-F0-9]{20}$"},
        "chapterCount": {"type": "integer", "minimum": 1, "maximum": 24}
      }
    },
    "viewBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["chapterId", "viewId", "profile", "architectureScope", "semanticHash", "layoutHash"],
      "properties": {
        "chapterId": {"type": "string", "pattern": "^CHAPTER-[A-F0-9]{20}$"},
        "viewId": {"type": "string", "pattern": "^VIEW-[A-F0-9]{24}$"},
        "profile": {"enum": ["module", "module_logic", "dependency_dataflow", "deployment_runtime", "sequence", "lifecycle", "evolution_risk"]},
        "architectureScope": {"enum": ["current", "target", "transition", "historical"]},
        "rootModuleId": {"$ref": "#/$defs/stableId"},
        "semanticHash": {"$ref": "#/$defs/sha256"},
        "layoutHash": {"$ref": "#/$defs/sha256"}
      },
      "allOf": [
        {
          "if": {"properties": {"profile": {"const": "module_logic"}}, "required": ["profile"]},
          "then": {"required": ["rootModuleId"]}
        }
      ]
    },
    "story": {
      "type": "object", "additionalProperties": false,
      "required": ["storyId", "kind", "title", "summary", "viewBinding", "coreRefIds", "defaultStepId", "steps"],
      "properties": {
        "storyId": {"type": "string", "pattern": "^STORY-[A-F0-9]{20}$"},
        "kind": {"enum": ["view", "module_logic_overview", "module_logic_node", "boundary_interaction", "progress", "decision", "risk", "transition", "evidence_freshness", "verification_trace"]},
        "title": {"type": "string", "minLength": 1, "maxLength": 512},
        "summary": {"type": "string", "maxLength": 2048},
        "viewBinding": {"$ref": "#/$defs/viewBinding"},
        "coreRefIds": {
          "type": "array", "maxItems": 256, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^CORE-[A-F0-9]{20}$"}
        },
        "defaultStepId": {"type": "string", "pattern": "^STEP-[A-F0-9]{20}$"},
        "steps": {
          "type": "array", "minItems": 1, "maxItems": 16,
          "items": {"$ref": "#/$defs/step"}
        }
      }
    },
    "playbackScenario": {
      "type": "object", "additionalProperties": false,
      "required": [
        "scenarioId", "businessFlowId", "title", "summary", "architectureScope",
        "factStatus", "status", "isDefault", "trigger", "outcome", "viewBinding",
        "coreRefIds", "steps", "informationGaps"
      ],
      "properties": {
        "scenarioId": {"type": "string", "pattern": "^SCENARIO-[A-F0-9]{20}$"},
        "businessFlowId": {"$ref": "#/$defs/stableId"},
        "title": {"type": "string", "minLength": 1, "maxLength": 512},
        "summary": {"type": "string", "maxLength": 2048},
        "architectureScope": {"enum": ["current", "target", "transition", "historical"]},
        "factStatus": {"enum": ["observed", "declared", "derived", "inferred", "unknown"]},
        "status": {"enum": ["draft", "active", "deprecated"]},
        "isDefault": {"type": "boolean"},
        "trigger": {"type": "string", "maxLength": 2048},
        "outcome": {"type": "string", "maxLength": 2048},
        "viewBinding": {"$ref": "#/$defs/viewBinding"},
        "coreRefIds": {
          "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^CORE-[A-F0-9]{20}$"}
        },
        "steps": {
          "type": "array", "minItems": 2, "maxItems": 64,
          "items": {"$ref": "#/$defs/playbackStep"}
        },
        "informationGaps": {
          "type": "array", "maxItems": 64, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 1024}
        }
      }
    },
    "playbackStep": {
      "type": "object", "additionalProperties": false,
      "required": [
        "playbackStepId", "sourceStepId", "order", "type", "title", "detail",
        "dataSummary", "result", "moduleId", "connectionId", "nodeId", "edgeId",
        "coreRefIds"
      ],
      "properties": {
        "playbackStepId": {"type": "string", "pattern": "^PLAYSTEP-[A-F0-9]{20}$"},
        "sourceStepId": {"$ref": "#/$defs/stableId"},
        "order": {"type": "integer", "minimum": 0, "maximum": 63},
        "type": {"enum": ["trigger", "processing", "data_transfer", "decision", "result", "failure", "compensation"]},
        "title": {"type": "string", "minLength": 1, "maxLength": 512},
        "detail": {"type": "string", "maxLength": 2048},
        "dataSummary": {"type": "string", "maxLength": 2048},
        "result": {"type": "string", "maxLength": 2048},
        "moduleId": {"$ref": "#/$defs/stableId"},
        "connectionId": {
          "oneOf": [{"$ref": "#/$defs/stableId"}, {"type": "null"}]
        },
        "nodeId": {
          "oneOf": [{"$ref": "#/$defs/stableId"}, {"type": "null"}]
        },
        "edgeId": {
          "oneOf": [{"$ref": "#/$defs/stableId"}, {"type": "null"}]
        },
        "coreRefIds": {
          "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^CORE-[A-F0-9]{20}$"}
        }
      }
    },
    "step": {
      "type": "object", "additionalProperties": false,
      "required": [
        "stepId", "order", "title", "summary", "claimBlocks", "focusNodeIds",
        "focusEdgeIds", "coreRefIds", "evidencePinIds", "informationGaps", "caveats"
      ],
      "properties": {
        "stepId": {"type": "string", "pattern": "^STEP-[A-F0-9]{20}$"},
        "order": {"type": "integer", "minimum": 0, "maximum": 15},
        "title": {"type": "string", "minLength": 1, "maxLength": 512},
        "summary": {"type": "string", "maxLength": 2048},
        "claimBlocks": {
          "type": "array", "minItems": 1, "maxItems": 16,
          "items": {"$ref": "#/$defs/claim"}
        },
        "focusNodeIds": {"$ref": "#/$defs/stableIdArray"},
        "focusEdgeIds": {"$ref": "#/$defs/stableIdArray"},
        "coreRefIds": {
          "type": "array", "maxItems": 64, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^CORE-[A-F0-9]{20}$"}
        },
        "evidencePinIds": {"$ref": "#/$defs/stableIdArray"},
        "informationGaps": {
          "type": "array", "maxItems": 64, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 1024}
        },
        "caveats": {
          "type": "array", "maxItems": 32, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 1024}
        }
      }
    },
    "claim": {
      "type": "object", "additionalProperties": false,
      "required": [
        "claimId", "kind", "text", "nodeIds", "edgeIds", "modelEntityIds",
        "modelRelationIds", "coreRefIds", "evidencePinIds", "gap"
      ],
      "properties": {
        "claimId": {"type": "string", "pattern": "^CLAIM-[A-F0-9]{20}$"},
        "kind": {"enum": ["bound_fact", "information_gap", "navigation"]},
        "text": {"type": "string", "minLength": 1, "maxLength": 2048},
        "nodeIds": {"$ref": "#/$defs/stableIdArray"},
        "edgeIds": {"$ref": "#/$defs/stableIdArray"},
        "modelEntityIds": {"$ref": "#/$defs/stableIdArray"},
        "modelRelationIds": {"$ref": "#/$defs/stableIdArray"},
        "coreRefIds": {
          "type": "array", "maxItems": 64, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^CORE-[A-F0-9]{20}$"}
        },
        "evidencePinIds": {"$ref": "#/$defs/stableIdArray"},
        "gap": {"type": ["string", "null"], "maxLength": 1024}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "bound_fact"}}, "required": ["kind"]}, "then": {"anyOf": [{"properties": {"nodeIds": {"minItems": 1}}}, {"properties": {"edgeIds": {"minItems": 1}}}, {"properties": {"modelEntityIds": {"minItems": 1}}}, {"properties": {"modelRelationIds": {"minItems": 1}}}, {"properties": {"coreRefIds": {"minItems": 1}}}, {"properties": {"evidencePinIds": {"minItems": 1}}}], "properties": {"gap": {"type": "null"}}}},
        {"if": {"properties": {"kind": {"const": "information_gap"}}, "required": ["kind"]}, "then": {"properties": {"gap": {"type": "string", "minLength": 1}}}},
        {"if": {"properties": {"kind": {"const": "navigation"}}, "required": ["kind"]}, "then": {"properties": {"nodeIds": {"maxItems": 0}, "edgeIds": {"maxItems": 0}, "modelEntityIds": {"maxItems": 0}, "modelRelationIds": {"maxItems": 0}, "coreRefIds": {"maxItems": 0}, "evidencePinIds": {"maxItems": 0}, "gap": {"type": "null"}}}}
      ]
    },
    "coreReference": {
      "type": "object", "additionalProperties": false,
      "required": ["coreRefId", "type", "id", "jsonPointer", "digest", "label", "summary", "status", "relatedCoreIds", "relatedModelEntityIds", "evidenceReferenceIds", "facts"],
      "properties": {
        "coreRefId": {"type": "string", "pattern": "^CORE-[A-F0-9]{20}$"},
        "type": {"enum": ["requirement", "work_item", "decision", "risk", "acceptance", "gate", "transition", "review", "reference", "module", "connection", "business_flow"]},
        "id": {"$ref": "#/$defs/stableId"},
        "jsonPointer": {"type": "string", "pattern": "^/", "maxLength": 512},
        "digest": {"$ref": "#/$defs/sha256"},
        "label": {"type": "string", "minLength": 1, "maxLength": 512},
        "summary": {"type": "string", "maxLength": 2048},
        "status": {"type": ["string", "null"], "maxLength": 128},
        "relatedCoreIds": {"$ref": "#/$defs/stableIdArray"},
        "relatedModelEntityIds": {"$ref": "#/$defs/stableIdArray"},
        "evidenceReferenceIds": {"$ref": "#/$defs/stableIdArray"},
        "facts": {
          "type": "array", "maxItems": 32,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["label", "value"],
            "properties": {
              "label": {"type": "string", "minLength": 1, "maxLength": 128},
              "value": {"type": "string", "maxLength": 2048}
            }
          }
        }
      }
    },
    "stableIdArray": {
      "type": "array", "maxItems": 64, "uniqueItems": true,
      "items": {"$ref": "#/$defs/stableId"}
    },
    "integrity": {
      "type": "object", "additionalProperties": false,
      "required": ["hashAlgorithm", "semanticHash", "semanticHashScope"],
      "properties": {
        "hashAlgorithm": {"const": "sha256"},
        "semanticHash": {"$ref": "#/$defs/sha256"},
        "semanticHashScope": {"const": "explain_pack_without_integrity"}
      }
    }
  }
}
