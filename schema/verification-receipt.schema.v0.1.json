{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-project-panorama.local/schema/verification-receipt.schema.v0.1.json",
  "title": "Panorama Verification Receipt V0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "receiptId",
    "projectBinding",
    "producer",
    "verifications",
    "evidence",
    "isolation",
    "redaction",
    "extensions"
  ],
  "properties": {
    "format": { "const": "panorama-verification-receipt.v0.1" },
    "receiptId": { "$ref": "#/$defs/id" },
    "projectBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectId",
        "panoramaRevision",
        "panoramaDataHash",
        "gitHead",
        "sourceSnapshotHash",
        "environment"
      ],
      "properties": {
        "projectId": { "$ref": "#/$defs/id" },
        "panoramaRevision": { "type": "integer", "minimum": 0 },
        "panoramaDataHash": { "$ref": "#/$defs/hash" },
        "gitHead": { "type": ["string", "null"], "maxLength": 256 },
        "sourceSnapshotHash": {
          "anyOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }]
        },
        "environment": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "generatedAt", "receiptHash"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "generatedAt": { "$ref": "#/$defs/timestamp" },
        "receiptHash": { "$ref": "#/$defs/hash" }
      }
    },
    "verifications": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": { "$ref": "#/$defs/verification" }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": { "$ref": "#/$defs/evidence" }
    },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "networkIsolation",
        "filesystemIsolation",
        "processTreeIsolation"
      ],
      "properties": {
        "networkIsolation": { "$ref": "#/$defs/isolationState" },
        "filesystemIsolation": { "$ref": "#/$defs/isolationState" },
        "processTreeIsolation": { "$ref": "#/$defs/isolationState" }
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applied", "removedFields", "sensitivity", "truncated"],
      "properties": {
        "applied": { "const": true },
        "removedFields": {
          "type": "array",
          "maxItems": 200,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 },
          "uniqueItems": true
        },
        "sensitivity": {
          "type": "string",
          "enum": ["public", "internal", "confidential", "restricted"]
        },
        "truncated": { "type": "boolean" },
        "notes": { "type": "string", "maxLength": 2048 }
      }
    },
    "extensions": { "type": "object", "additionalProperties": true }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9._:-]{1,127}$" },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "idList": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/id" },
      "uniqueItems": true
    },
    "isolationState": {
      "type": "string",
      "enum": ["enforced", "not_enforced", "not_executed", "unknown"]
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["findingId", "severity", "category", "summary", "evidenceIds"],
      "properties": {
        "findingId": { "$ref": "#/$defs/id" },
        "severity": {
          "type": "string",
          "enum": ["info", "low", "medium", "high", "critical"]
        },
        "category": { "type": "string", "minLength": 1, "maxLength": 128 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "evidenceIds": { "$ref": "#/$defs/idList" }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verificationId",
        "status",
        "summary",
        "startedAt",
        "completedAt",
        "gateIds",
        "acceptanceCriteriaIds",
        "evidenceIds",
        "findings"
      ],
      "properties": {
        "verificationId": { "$ref": "#/$defs/id" },
        "status": {
          "type": "string",
          "enum": ["passed", "failed", "partial", "not_run", "error"]
        },
        "summary": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "startedAt": {
          "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }]
        },
        "completedAt": {
          "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }]
        },
        "gateIds": { "$ref": "#/$defs/idList" },
        "acceptanceCriteriaIds": { "$ref": "#/$defs/idList" },
        "evidenceIds": { "$ref": "#/$defs/idList" },
        "findings": {
          "type": "array",
          "maxItems": 500,
          "items": { "$ref": "#/$defs/finding" }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceId",
        "title",
        "summary",
        "locationType",
        "location",
        "sizeBytes",
        "sha256",
        "sensitive"
      ],
      "properties": {
        "evidenceId": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1, "maxLength": 256 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "locationType": {
          "type": "string",
          "enum": ["relative_path", "url", "inline_note"]
        },
        "location": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "sizeBytes": { "type": "integer", "minimum": 0, "maximum": 1073741824 },
        "sha256": { "$ref": "#/$defs/hash" },
        "sensitive": { "const": false }
      }
    }
  }
}
