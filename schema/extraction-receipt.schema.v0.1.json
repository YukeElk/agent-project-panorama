{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/panorama/extraction-receipt.schema.v0.1.json",
  "title": "Panorama Extraction Receipt v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "receiptId",
    "observedAt",
    "producer",
    "projectBinding",
    "inputBinding",
    "outputBinding",
    "status",
    "counts",
    "adapters",
    "safety",
    "integrity",
    "extensions"
  ],
  "properties": {
    "formatVersion": {"const": "panorama-extraction-receipt.v0.1"},
    "receiptId": {"type": "string", "pattern": "^SRCREC-[A-F0-9]{24}$"},
    "observedAt": {"type": "string", "format": "date-time"},
    "producer": {"$ref": "#/$defs/producer"},
    "projectBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectId", "rootName"],
      "properties": {
        "projectId": {"$ref": "#/$defs/stableId"},
        "rootName": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "inputBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "gitHead", "contentDigest", "fileCount"],
      "properties": {
        "mode": {"enum": ["git", "content_digest"]},
        "gitHead": {
          "oneOf": [
            {"type": "string", "pattern": "^[a-fA-F0-9]{40}([a-fA-F0-9]{24})?$"},
            {"type": "null"}
          ]
        },
        "contentDigest": {"$ref": "#/$defs/sha256"},
        "fileCount": {"type": "integer", "minimum": 0}
      }
    },
    "outputBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observationId", "observationHash", "lossReportId", "lossReportHash"],
      "properties": {
        "observationId": {"type": "string", "pattern": "^SRCOBS-[A-F0-9]{24}$"},
        "observationHash": {"$ref": "#/$defs/sha256"},
        "lossReportId": {"type": "string", "pattern": "^LOSS-[A-F0-9]{16,64}$"},
        "lossReportHash": {"$ref": "#/$defs/sha256"}
      }
    },
    "status": {"enum": ["completed", "partial", "blocked"]},
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filesDiscovered",
        "filesRead",
        "elements",
        "relations",
        "unresolvedRelations",
        "parseFailures",
        "secretRiskExcluded"
      ],
      "properties": {
        "filesDiscovered": {"type": "integer", "minimum": 0},
        "filesRead": {"type": "integer", "minimum": 0},
        "elements": {"type": "integer", "minimum": 0},
        "relations": {"type": "integer", "minimum": 0},
        "unresolvedRelations": {"type": "integer", "minimum": 0},
        "parseFailures": {"type": "integer", "minimum": 0},
        "secretRiskExcluded": {"type": "integer", "minimum": 0}
      }
    },
    "adapters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "status", "inputCount", "outputCount", "errorCount"],
        "properties": {
          "id": {"$ref": "#/$defs/stableId"},
          "version": {"type": "string", "minLength": 1, "maxLength": 128},
          "status": {"enum": ["completed", "partial", "not_applicable", "blocked"]},
          "inputCount": {"type": "integer", "minimum": 0},
          "outputCount": {"type": "integer", "minimum": 0},
          "errorCount": {"type": "integer", "minimum": 0}
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "networkAccessed",
        "projectMutated",
        "sourceBodiesReadTransiently",
        "sourceBodyPersisted",
        "classifiedSecretPathsRead",
        "embeddedSecretScan",
        "externalPrivateDataRead",
        "symlinkPolicy"
      ],
      "properties": {
        "networkAccessed": {"const": false},
        "projectMutated": {"const": false},
        "sourceBodiesReadTransiently": {"type": "boolean"},
        "sourceBodyPersisted": {"const": false},
        "classifiedSecretPathsRead": {"const": false},
        "embeddedSecretScan": {"const": "not_performed"},
        "externalPrivateDataRead": {"const": false},
        "symlinkPolicy": {"const": "reject_in_scope"}
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hashAlgorithm", "receiptHash", "hashScope"],
      "properties": {
        "hashAlgorithm": {"const": "sha256"},
        "receiptHash": {"$ref": "#/$defs/sha256"},
        "hashScope": {"const": "receipt_without_integrity"}
      }
    },
    "extensions": {"type": "object"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "stableId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"$ref": "#/$defs/stableId"},
        "version": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    }
  }
}
