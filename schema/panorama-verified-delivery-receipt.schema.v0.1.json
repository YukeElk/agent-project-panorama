{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-project-panorama.local/schema/panorama-verified-delivery-receipt.schema.v0.1.json",
  "title": "Panorama Verified Delivery Receipt v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "deliveryId", "generatedAt", "projectBinding", "modelBinding", "bundleBinding", "viewBindings", "artifact", "gates", "informationGaps", "integrity"],
  "properties": {
    "formatVersion": {"const": "panorama-verified-delivery-receipt.v0.1"},
    "deliveryId": {"type": "string", "pattern": "^PVD-[A-F0-9]{24}$"},
    "generatedAt": {"type": "string", "format": "date-time"},
    "projectBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["projectId", "panoramaSchemaVersion", "revision", "dataHash"],
      "properties": {
        "projectId": {"type": "string", "minLength": 1, "maxLength": 128},
        "panoramaSchemaVersion": {"enum": ["0.1", "0.2"]},
        "revision": {"type": "integer", "minimum": 0},
        "dataHash": {"$ref": "#/$defs/sha256"}
      }
    },
    "modelBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["modelId", "semanticHash"],
      "properties": {
        "modelId": {"type": "string", "pattern": "^MODEL-[A-F0-9]{24}$"},
        "semanticHash": {"$ref": "#/$defs/sha256"}
      }
    },
    "bundleBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["bundleId", "bundleHash", "renderer"],
      "properties": {
        "bundleId": {"type": "string", "pattern": "^PVB-[A-F0-9]{24}$"},
        "bundleHash": {"$ref": "#/$defs/sha256"},
        "renderer": {
          "type": "object", "additionalProperties": false,
          "required": ["id", "version"],
          "properties": {"id": {"const": "panorama-multi-view-renderer"}, "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}}
        }
      }
    },
    "viewSetBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["viewSetId", "semanticHash", "defaultChapterId", "chapterCount"],
      "properties": {
        "viewSetId": {"type": "string", "pattern": "^PVS-[A-F0-9]{24}$"},
        "semanticHash": {"$ref": "#/$defs/sha256"},
        "defaultChapterId": {"type": "string", "pattern": "^CHAPTER-[A-F0-9]{20}$"},
        "chapterCount": {"type": "integer", "minimum": 1, "maximum": 24}
      }
    },
    "viewBindings": {
      "type": "array", "minItems": 1, "maxItems": 24,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["viewId", "profile", "semanticHash", "layoutHash"],
        "properties": {
          "viewId": {"type": "string", "pattern": "^VIEW-[A-F0-9]{24}$"},
          "profile": {"enum": ["module", "dependency_dataflow", "deployment_runtime", "sequence", "lifecycle", "evolution_risk"]},
          "semanticHash": {"$ref": "#/$defs/sha256"},
          "layoutHash": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["ref", "sha256", "bytes", "mediaType"],
      "properties": {
        "ref": {"$ref": "#/$defs/relativeRef"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1},
        "mediaType": {"const": "text/html; charset=utf-8"}
      }
    },
    "gates": {
      "type": "object", "additionalProperties": false,
      "required": ["modelView", "geometry", "privacy", "offlineSecurity", "browser", "visualReview"],
      "properties": {
        "modelView": {"const": "passed"},
        "geometry": {"const": "passed"},
        "privacy": {"const": "passed"},
        "offlineSecurity": {"const": "passed"},
        "browser": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "evidenceRef", "evidenceHash"],
          "properties": {
            "status": {"enum": ["passed", "not_provided"]},
            "evidenceRef": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/relativeRef"}]},
            "evidenceHash": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]}
          }
        },
        "visualReview": {"const": "pending"}
      }
    },
    "informationGaps": {"type": "array", "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 200}},
    "integrity": {
      "type": "object", "additionalProperties": false,
      "required": ["receiptHash"],
      "properties": {"receiptHash": {"$ref": "#/$defs/sha256"}}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "relativeRef": {"type": "string", "minLength": 1, "maxLength": 300, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"}
  }
}
